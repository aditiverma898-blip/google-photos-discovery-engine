node_modules/
frontend/dist/
frontend/build/
.vite/
.vercel/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Database ---
*.sql.bak
*.dump

# --- Logs ---
*.log
logs/

# --- Testing ---
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# --- OS ---
.DS_Store
Desktop.ini
ehthumbs.db

# --- Misc ---
*.bak
*.tmp
pipeline.lock

