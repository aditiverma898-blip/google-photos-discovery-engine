# ============================================================
# Google Photos Discovery Engine — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Gemini AI (Google AI Studio) ---
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
COPILOT_USE_GEMINI=true
COPILOT_GEMINI_MODEL=gemini-flash-latest


APIFY_TOKEN=your_apify_token_here

# --- YouTube Data API v3 ---
# Enable at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- PostgreSQL Database ---
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discovery_engine

# --- Application Settings ---
# Backend server port
BACKEND_PORT=8000
# Frontend dev server URL (for CORS)
FRONTEND_URL=http://localhost:5173
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
